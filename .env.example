# Copia este archivo como .env y completa los valores. NUNCA subas .env a GitHub.
# Cadena de conexión de Neon (Dashboard > Connect > copiar la "pooled connection")
DATABASE_URL=postgresql://usuario:clave@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Una frase larga y aleatoria (mínimo 32 caracteres)
JWT_SECRET=cambia-esto-por-una-frase-larga-y-aleatoria-123456
PORT=3000
# Admin que se crea con "npm run db:setup"
ADMIN_CORREO=admin@aftershock.app
ADMIN_CLAVE=CambiaEstaClave2026
